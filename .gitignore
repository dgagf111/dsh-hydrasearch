# Dependencies
node_modules/
.pnpm-store/

# Deployment artifacts produced by scripts/deploy.mjs (staging dir it renames
# into place) — never commit a half-written install.
.staging/

# Local secrets. The plugin stores API keys in the credential center
# (`$DSH_HOME/.credentials.yaml`) and nowhere else; none of these may ever be
# tracked here.
.env
.env.*
!.env.example
*.key

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs and scratch output
*.log
npm-debug.log*
pnpm-debug.log*
coverage/
*.tsbuildinfo
